# ================================================
# PATIENT MANAGEMENT SYSTEM - ROOT .gitignore
# ================================================

# ================================================
# BACKEND (Java/Spring Boot/Maven)
# ================================================

# Maven
pm-backend/**/target/
pm-backend/**/.mvn/
pm-backend/**/mvnw
pm-backend/**/mvnw.cmd

# Compiled class files
pm-backend/**/*.class

# Log files
pm-backend/**/*.log
pm-backend/**/logs/

# Package files
pm-backend/**/*.jar
pm-backend/**/*.war
pm-backend/**/*.nar
pm-backend/**/*.ear
pm-backend/**/*.zip
pm-backend/**/*.tar.gz
pm-backend/**/*.rar

# Virtual machine crash logs
pm-backend/**/hs_err_pid*

# Spring Boot
pm-backend/**/HELP.md
pm-backend/**/.spring-boot-devtools.properties

# Database
pm-backend/**/*.db
pm-backend/**/database/
pm-backend/**/data/

# gRPC generated files (optional - keep if needed)
# pm-backend/**/src/**/generated/

# ================================================
# FRONTEND (Next.js/React/Node)
# ================================================

# Dependencies
pm-frontend/**/node_modules/
pm-frontend/**/.pnp
pm-frontend/**/.pnp.js

# Testing
pm-frontend/**/coverage

# Next.js
pm-frontend/**/.next/
pm-frontend/**/out/

# Production
pm-frontend/**/build
pm-frontend/**/dist

# Environment variables
pm-frontend/**/.env*.local
pm-frontend/**/.env.local
pm-frontend/**/.env.development.local
pm-frontend/**/.env.test.local
pm-frontend/**/.env.production.local

# Vercel
pm-frontend/**/.vercel

# TypeScript
pm-frontend/**/*.tsbuildinfo
pm-frontend/**/next-env.d.ts

# Debug logs
pm-frontend/**/npm-debug.log*
pm-frontend/**/yarn-debug.log*
pm-frontend/**/yarn-error.log*
pm-frontend/**/pnpm-debug.log*
pm-frontend/**/lerna-debug.log*

# ================================================
# IDE & EDITORS
# ================================================

# IntelliJ IDEA
**/.idea/
**/*.iws
**/*.iml
**/*.ipr

# VSCode
**/.vscode/
**/*.code-workspace

# Eclipse
**/.apt_generated
**/.classpath
**/.factorypath
**/.project
**/.settings
**/.springBeans
**/.sts4-cache

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# ================================================
# OPERATING SYSTEMS
# ================================================

# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*

# Windows
**/Thumbs.db
**/Thumbs.db:encryptable
**/ehthumbs.db
**/ehthumbs_vista.db
**/[Dd]esktop.ini
**/$RECYCLE.BIN/

# Linux
**/.directory
**/.Trash-*

# ================================================
# DOCKER & CONTAINERS
# ================================================

**/*.log
**/docker-compose.override.yml
**/.dockerignore

# ================================================
# TEMPORARY FILES
# ================================================

**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
**/.cache/

# ================================================
# SECURITY & SECRETS
# ================================================

# Environment variables & secrets
**/.env
**/.env.*.local
**/secrets/
**/credentials/
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.jks

# ================================================
# BUILD ARTIFACTS
# ================================================

**/dist/
**/build/
**/out/
**/target/

# ================================================
# KAFKA & ZOOKEEPER
# ================================================

**/kafka-logs/
**/zookeeper/

# ================================================
# DATABASES
# ================================================

**/*.sql
**/*.sqlite
**/*.sqlite3
**/postgres-data/

# ================================================
# TESTING & COVERAGE
# ================================================

**/coverage/
**/.nyc_output/
**/test-results/
**/*.lcov

# ================================================
# MISC
# ================================================

**/.antigravityignore
